# CrediGuide backend configuration — copy to .env and fill in real values.
# NEVER commit a real .env file.

PORT=5000

# MongoDB connection string (MongoDB Atlas)
MONGO_URI=

# Secret used to sign login tokens
JWT_SECRET=

# Frontend origin allowed by CORS
CLIENT_URL=http://localhost:5173

# SMS provider: fast2sms (default) or msg91 (legacy, needs own DLT)
SMS_PROVIDER=fast2sms

# Fast2SMS Dev API authorization key (Fast2SMS panel -> API Key)
FAST2SMS_API_KEY=

# MSG91 (legacy provider, only used when SMS_PROVIDER=msg91)
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_OTP_EXPIRY=10

# true = OTPs print in the server terminal instead of sending SMS
# (local development only; keep false wherever real users register)
DEV_OTP_MODE=false
